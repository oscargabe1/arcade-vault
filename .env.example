# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Con el remitente onboarding@resend.dev, Resend solo entrega al correo de la cuenta dueña de la API key.
CONTACT_TO_EMAIL=

# Supabase (app: .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para Supabase CLI (db push / link), nunca en la app. El CLI la lee del entorno/.env
SUPABASE_DB_PASSWORD=
